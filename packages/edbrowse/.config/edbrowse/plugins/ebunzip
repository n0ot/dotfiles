#!/usr/bin/env python
from __future__ import print_function
import os
import sys
import zipfile
from urllib import quote, unquote

class Node(object):
	def __init__(self, parent=None, name="", is_dir=False):
		self.nodes = {}
		self.name = name
		self.parent = parent
		self.is_dir = is_dir

	def add(self, fn):
		components = fn.split('/')
		parent = self
		for d in components[:-1]:
			if d in parent.nodes:
				parent = parent.nodes[d]
				continue
			parent.nodes[d] = Node(parent=parent, name=d, is_dir=True)
			parent = parent.nodes[d]
		parent.nodes[components[-1]] = Node(parent=parent, name=components[-1], is_dir=False)

	def lookup(self, path):
		if path == "":
			return self
		node = self
		for item in path.split('/'):
			if item == '':
				continue
			node = node.nodes[item]
		return node

	def get_full_name(self):
		if self.parent is None:
			return ""
		return self.parent.get_full_name() + "/" + self.name

if len(sys.argv) != 2:
	print("Usage: %s path" % sys.argv[0])
	sys.exit(1)
extract = False
url = sys.argv[1]
if url.startswith('zipxd://'):
	fn = unquote(url[8:url.find(':::')])
	path = unquote(url[url.find(':::')+3:].lstrip('/'))
elif url.startswith('zipx://'):
	fn = unquote(url[7:url.find(':::')])
	path = unquote(url[url.find(':::')+3:].lstrip('/'))
	extract = True
else:
	fn = url
	path = ""
zf = zipfile.ZipFile(fn)
if extract:
	sys.stdout.write(zf.read(path))
	sys.exit(0)
root = Node(parent=None)
infos = sorted(zf.infolist(), key=lambda x: x.filename)
print("<body>Zip Archive<br>")
for info in infos:
	if info.filename.endswith('/'):
		continue
	root.add(info.filename)
start_node = root.lookup(path)
for node in sorted(start_node.nodes):
	name = node
	node = start_node.nodes[node]
	is_dir = ("/" if node.is_dir else "")
	if is_dir:
		url = 'zipxd://' + quote(fn) + ":::" + quote(node.get_full_name())
	else:
		url = 'zipx://' + quote(fn) + ":::" + quote(node.get_full_name())
	print("<a href=\"%s\">%s%s</a><br>" % (url, name, is_dir))
