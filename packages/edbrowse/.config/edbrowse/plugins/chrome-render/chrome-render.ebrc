plugin {
    type = */*
    desc = Render page with Chrome
    protocol = chrmrndr
    program = uv run --project ~/.config/edbrowse/plugins/chrome-render ~/.config/edbrowse/plugins/chrome-render/chrome-render.py %i
    outtype = h
}

function+chrome {
    db0
    0A
    2,d
    s;^<br><a href='\(.*\)'>$;b chrmrndr://$1;f
    bw
    up
    db1
    <*-1
}
