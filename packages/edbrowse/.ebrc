jar=~/.local/share/edbrowse/cookiejar
downdir = ~/downloads
cachesize=0

agent=Links (2.29; Linux 6.11.0-13-generic x86_64; GNU C 13.2; text)
agent=Mozilla/4.0 (compatible; MSIE 5.5; Windows 98; Win 9x 4.90)
agent=Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 6.1; WOW64; Trident/5.0; SLCC2; .NET CLR 2.0.50727; .NET CLR 3.5.30729; .NET CLR 3.0.30729; Media Center PC 6.0; .NET4.0C; .NET4.0E)
agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/72.0.3112.113 Safari/537.36

agentsite = google.com 1

plugin {
    type = zip
    desc = zip archive
    suffix = zip
    program = ~/.config/edbrowse/plugins/ebunzip %i
    from_file
    outtype = H
}

plugin {
    type = zip
    desc = zip show directory
    protocol = zipxd
    program = ~/.config/edbrowse/plugins/ebunzip %i
    outtype = H
}

plugin {
    type = zip
    desc = zip extract file
    protocol = zipx
    program = ~/.config/edbrowse/plugins/ebunzip %i
    outtype = T
}

plugin {
    type = rar
    desc = rar archive
    suffix = rar
    program = ~/.config/edbrowse/plugins/ebunrar %i
    from_file
    outtype = H
}

plugin {
    type = rar
    desc = rar show directory
    protocol = rarxd
    program = ~/.config/edbrowse/plugins/ebunrar %i
    outtype = H
}

plugin {
    type = rar
    desc = rar extract file
    protocol = rarx
    program = ~/.config/edbrowse/plugins/ebunrar %i
    outtype = T
}

plugin {
    type = markdown
    desc = markdown file
    suffix = md
    program = pandoc --toc -f markdown %i
    outtype = H
    down_url
}

plugin {
    type = epub
    desc = epub file
    suffix = epub
    content = application/epub+zip
    #  %o is the temp output file generated by the program
    program = pandoc -f epub %i
    outtype = H
    down_url
}

plugin {
    type = pdf
    desc = pdf file
    suffix = pdf
    content = application/pdf
    #  file must be local
    down_url
    program = pdftohtml -i -noframes %i %o >/dev/null
    outtype = H
}

plugin {
    type = audio
    desc = streaming audio
    protocol = rtsp,pnm,sdp,pls
    suffix = rm,ra,ram,ogg,mp3,mp4,m3u,m3u8,opus,flac,m4a
    content = audio/x-scpls,audio/mpeg,application/pls+xml
    program = mpv --really-quiet --no-audio-display --no-ytdl --af=scaletempo=stride=20:overlap=1 %i
}

include = ~/.config/edbrowse/plugins/gemini/gemini.ebrc
include = ~/.config/edbrowse/plugins/chrome-render/chrome-render.ebrc

function:init {
    db0
    js-
    sg+
    ci+
    dx
    endm+
    rl+
    z38
ls=s
    db1
}

function+gg {
    db0
    enew
    r !echo '<form action="https://www.google.com/search">'
    r !echo '<input name="q"><input type="submit">'
    bw
    b
    sw+
    i=~0
    nostack     i*
    6
    /^{
    db1
}

function+kg {
    db0
    enew
    a
    <form action="https://www.kagi.com/html/search">
    <input name="q"><input type="submit">
    .
    bw
    b
    sw+
    i=~0
    nostack     i*
    0A
    2,$d
    /kagi.com/X
    if(*) {
        bw
        ^
        db1
        /^h3 
    } else {
        bw
        ^
        db1
        ft
    }
}

function+ddg {
    db0
    enew
    r !echo '<form method="POST" action="https://html.duckduckgo.com/html">'
    r !echo '<input name="q"><input type="submit">'
    bw
    b
    i=~0
    i*
    sw+
    g/^h2 Ad/X
    if(?) {
        # There are no sponsored results to skip past. That's okay.
    }
    db1
    /^h\d {
}

function+bg {
    db0
    enew
    r !echo '<form action="https://www.biblegateway.com/quicksearch">'
    r !echo '<input name="quicksearch"><input name="qs_version"><input type="submit">'
    bw
    b
    i1=~0
    i2=NRSVCE
    i*
    db1
    /<Update>$/+2
}

function:b {
    b ~/.local/share/edbrowse/bookmarks.html
}

function+atb {
db0
0A
    4X
    if(*) {
        !echo This would add more than one bookmark
        return
    }
    ,j
    w+ ~/.local/share/edbrowse/bookmarks.html
    ^
    db1
}

function:h {
    b http://~0
}

function:hs {
    b https://~0
}

# Play the current buffer in mpv
# Sometimes useful over pb because it handles youtube-dl and works in browse mode
function+play {
    !mpv --ytdl-format=bestaudio --no-audio-display --no-video --af=scaletempo=stride=20:overlap=1 "$EB_BASE"
}

# Background mpv playback

# Helper function to play the current buffer
function+mpvlf {
    !jq -nc --arg filename "$(~/.config/edbrowse/plugins/ebabspath.py "$EB_BASE")" '{command: ["loadfile", $filename, "~1"]}' | socat - /tmp/media-mpv-ipc > /dev/null
}

# Play the current buffer, replacing the current playlist
function+pr {
    <mpvlf replace
}

# Play the current buffer, appending  to the current playlist
function+pa {
    <mpvlf append-play
}

function+rfc {
    b https://tools.ietf.org/html/rfc~1
}

function+o {
    !open "$EB_BASE"
}

function:nws {
    b https://forecast.weather.gov/zipcity.php?inputstring=~0
}

function:cpp {
    !printf %s "$EB_BASE" | pbcopy
}

function+hnn {
    sw-
    /^\d+\.$/f+2
    if(?) {
        /^{More}$/f
    }
}

function+hnp {
    sw-
    # If we're on the first line of the post title, going up two lines will move
    # to this posts number, so we can then search for the one before it.
    # If we're not of the first line of this post's title, <hnp will move there
    # instead of going to the previous post.
    -2 X
    ?^\d+\.$?f+2
    if(?) {
        # No previous post was found, so undo the -2 X
        +2 X
    }
}

function+lsn {
    sw-
    /^\d+\.$/f+2
    if(?) {
        /^\({<< Page \d+} | \)?{Page \d+ >>}$/f
    }
}

function+lsp {
    sw-
    # If we are no more than 1 line from the bottom of the file,
    # We are on or after the next page line, and don't want to skip past the previous ^\d+\.$.
    +2X
    if(*) {
        -2X
        ?^\d+\.$?f- X
}
    ?^\d+\.$?f+2
}

function:gmni {
    b gemini://~0
}

function:gmniccon {
    db0
    !touch ~/.config/edbrowse/plugins/ebgmni-client-cert-enabled
}

function:gmniccoff {
    db0
    !rm -f ~/.config/edbrowse/plugins/ebgmni-client-cert-enabled
}

function+explsh {
    db0
    b https://explainshell.com
    /<
    i=~0
    i*
    db1
    /^\({[^}]+(\d)}\|h4 \)/
}

function:gopkg {
    b https://pkg.go.dev/~1
}

function+oldred {
    db0
    0A
    1s/www/old/
    bw
    db1
    nostack g
    /^submitted 
}
